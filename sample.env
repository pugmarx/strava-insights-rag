# AI Provider (groq / huggingface / ollama)
LLM_PROVIDER="groq"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional Fallbacks / Alternative Providers
HF_TOKEN=""
HF_MODEL="Qwen/Qwen2.5-72B-Instruct"

# Strava API
STRAVA_USER_ID="<GET_FROM_STRAVA>"
STRAVA_CLIENT_ID="<GET_FROM_STRAVA>"
STRAVA_CLIENT_SECRET="<GET_FROM_STRAVA>"

# Database (Supabase / Neon / Local PostgreSQL)
POSTGRES_DB="postgres"
POSTGRES_USER="postgres.yourprojectid"
POSTGRES_PASSWORD="your_db_password"
POSTGRES_HOST="aws-0-us-east-1.pooler.supabase.com"
POSTGRES_PORT="5432"
POSTGRES_SSLMODE="require"

# Server Port (7860 for Hugging Face Spaces, 5000 for local)
PORT=7860